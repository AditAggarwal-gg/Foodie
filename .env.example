# Local dev default: Ollama (free, runs on your machine, no signup)
LLM_PROVIDER=ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Production (Render) uses Groq instead — set these in Render's dashboard,
# not here. This file is only for local dev and is safe to commit.
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile

PORT=3000
